   "source": [
    "from fabrictestbed_extensions.fablib.fablib import FablibManager as fablib_manager\n",
    "\n",
    "try:\n",
    "    fablib = fablib_manager(project_id="f5b4fc7d-978f-45be-9530-b38db8ef5046")\n",
    "    slice_name = \"Stock_Platform_5_Node\"\n",
    "    \n",
    "    slice = fablib.new_slice(name=slice_name)\n",
    "\n",
    "    # 1. Add the Market Streamer (Node 1)\n",
    "    master = slice.add_node(name=\"MarketProvider\", site=\"TACC\")\n",
    "    master.add_fabnet() \n",
    "\n",
    "    # 2. Add 4 Trading Workers (Nodes 2-5)\n",
    "    for i in range(1, 5):\n",
    "        worker = slice.add_node(name=f\"Worker_{i}\", site=\"TACC\")\n",
    "        worker.add_fabnet()\n",
    "\n",
    "    print(\"Submitting slice request to FABRIC...\")\n",
    "    slice.submit()\n",
    "    \n",
    "    # 3. Configure all 5 nodes \n",
    "    nodes = slice.get_nodes()\n",
    "    for node in nodes:\n",
    "        node.execute(\"sudo apt-get update && sudo apt-get install -y python3-pip\")\n",
    "        node.execute(\"pip3 install zmq pandas numpy\")\n",
    "        \n",
    "        # Upload scripts based on role\n",
    "        if node.get_name() == \"MarketProvider\":\n",
    "            node.upload_file(\"src/MarketStreamer.py\", \"MarketStreamer.py\")\n",
    "        else:\n",
    "            node.upload_file(\"src/TradingLogic.py\", \"TradingLogic.py\")\n",
    "\n",
    "    print(\"5-Node Topology Ready.\")\n",
    "except Exception as e:\n",
    "    print(f\"Deployment failed: {e}\")"
   ]
  }
 ],
